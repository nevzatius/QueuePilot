{
  "name": "queuepilot",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=24 <25", "pnpm": ">=10 <11" },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b && node scripts/workspaces.mjs typecheck",
    "test": "node scripts/test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -b && node scripts/workspaces.mjs build && node scripts/build.mjs",
    "emulators": "firebase emulators:start --project demo-queuepilot --only auth,firestore"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@queuepilot/contracts": "workspace:*",
    "@queuepilot/core": "workspace:*",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "firebase-tools": "15.34.0",
    "redis": "6.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
