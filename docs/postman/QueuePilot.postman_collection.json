      "name": "1. Identity (needs idToken)",
      "item": [
        {
          "name": "GET /api/v1/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/me",
            "description": "Identity comes from the verified token; the membership (tenant and role) is read from Firestore."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('idToken')) {",
                  "  throw new Error('idToken is empty. Copy the Bearer token from the browser (README step 3) into the environment variable idToken.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('uid present', () => pm.expect(b.uid).to.be.a('string').and.not.empty);",
                  "pm.test('has a membership (grant-role was run)', () => pm.expect(b.membership).to.be.an('object'));",
                  "console.log('role=' + (b.membership && b.membership.role) + ' tenant=' + (b.membership && b.membership.tenantId));",
                  "pm.test('x-correlation-id header present', () => pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty);",
                  "pm.test('cache-control is no-store', () => pm.expect(pm.response.headers.get('cache-control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
