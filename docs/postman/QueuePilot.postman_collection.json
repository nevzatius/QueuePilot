  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const cid = pm.response.headers.get('x-correlation-id') || '-';",
          "const ms = pm.response.responseTime;",
          "console.log('[' + pm.info.requestName + '] ' + pm.request.method + ' -> ' + pm.response.code + ' in ' + ms + ' ms, correlation=' + cid);",
          "if (ms > 8000) console.warn('slow answer: probably a Render cold start (API about 30 s, worker about 25 s)');",
          "if (pm.response.code >= 400 && pm.response.headers.get('content-type') && pm.response.headers.get('content-type').includes('problem+json')) {",
          "  const p = pm.response.json(); console.log('  problem: code=' + p.code + ' errors=' + JSON.stringify(p.errors || []));",
          "}"
        ]
      }
    }
