        {
          "name": "2.6 GET /requests/{id} (run repeatedly until terminal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/requests/{{requestId}}",
            "description": "The worker lease, attempt count and timeline are visible here. Look at the Postman Console."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('idToken')) {",
                  "  throw new Error('idToken is empty. Copy the Bearer token from the browser (README step 3) into the environment variable idToken.');",
                  "}",
                  "// wait 3 s before every repeat poll, so the time budget below is real time (a cold worker needs 25-35 s)",
                  "if (Number(pm.collectionVariables.get('pollCount') || 0) > 0) { setTimeout(() => {}, 3000); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const n = Number(pm.collectionVariables.get('pollCount') || 0) + 1;",
                  "const t0 = Number(pm.collectionVariables.get('pollStart') || Date.now());",
                  "pm.collectionVariables.set('pollStart', t0);",
                  "const waited = Math.round((Date.now() - t0) / 1000);",
                  "pm.collectionVariables.set('pollCount', n);",
                  "console.log('poll ' + n + ' (' + waited + ' s): status=' + b.status + ' attempts=' + b.attempts + '/' + b.maxAttempts + ' events=' + b.events.map(e => e.type + '@' + e.actor).join(' > '));",
                  "const terminal = ['COMPLETED', 'FAILED'].includes(b.status);",
                  "if (!terminal && waited < 150) {",
                  "  pm.execution.setNextRequest(pm.info.requestName);  // repeats every ~3 s, for at most 150 s",
                  "} else {",
                  "  pm.collectionVariables.unset('pollCount'); pm.collectionVariables.unset('pollStart');",
                  "  pm.test('reached COMPLETED', () => pm.expect(b.status).to.eql('COMPLETED'));",
                  "  pm.test('triage result present', () => pm.expect(b.result).to.have.property('lane'));",
                  "  pm.test('timeline starts with ACCEPTED (api) and ends with COMPLETED (worker)', () => {",
                  "    pm.expect(b.events[0].type).to.eql('ACCEPTED'); pm.expect(b.events[0].actor).to.eql('api');",
                  "    pm.expect(b.events[b.events.length - 1].type).to.eql('COMPLETED');",
                  "  });",
                  "  pm.test('no duplicate deliveries on a clean run', () => pm.expect(b.duplicateDeliveries).to.eql(0));",
                  "  const t = b.events.map(e => new Date(e.at).getTime());",
                  "  console.log('accepted -> processing started: ' + ((t[1] - t[0]) / 1000) + ' s (a cold worker took 25-35 s in earlier runs)');",
                  "  console.log('processing started -> completed: ' + ((t[t.length - 1] - t[1]) / 1000) + ' s');",
                  "}",
                  "pm.test('x-correlation-id header present', () => pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty);",
                  "pm.test('cache-control is no-store', () => pm.expect(pm.response.headers.get('cache-control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
