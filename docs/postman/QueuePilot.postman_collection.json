    {
      "name": "2. Requests lifecycle (needs idToken; step 2.1 uses 1 of your 30 daily submissions)",
      "item": [
        {
          "name": "2.1 POST /requests (new)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/requests",
            "description": "202 means committed in Firestore, not processed. The queue wake-up is sent after the commit.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"support_ticket\",\n  \"title\": \"Postman test request\",\n  \"description\": \"Created by the Postman collection\",\n  \"priority\": \"high\",\n  \"attributes\": {\n    \"safetyRisk\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('idToken')) {",
                  "  throw new Error('idToken is empty. Copy the Bearer token from the browser (README step 3) into the environment variable idToken.');",
                  "}",
                  "pm.collectionVariables.set('idemKey', 'pm-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.unset('pollCount'); pm.collectionVariables.unset('pollStart');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.test('requestId is a uuid', () => pm.expect(b.requestId).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.test('Location header equals body.location', () => pm.expect(pm.response.headers.get('location')).to.eql(b.location));",
                  "pm.test('first creation has no Idempotent-Replayed header', () => pm.expect(pm.response.headers.has('idempotent-replayed')).to.be.false);",
                  "pm.collectionVariables.set('requestId', b.requestId);",
                  "console.log('requestId=' + b.requestId + ' idemKey=' + pm.collectionVariables.get('idemKey'));",
                  "pm.test('x-correlation-id header present', () => pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty);",
                  "pm.test('cache-control is no-store', () => pm.expect(pm.response.headers.get('cache-control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
