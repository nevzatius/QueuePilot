# API origin. Leave empty to use the same origin (Firebase Hosting rewrite or the Vite dev proxy).
VITE_API_BASE_URL=
# Dev proxy target for /api when VITE_API_BASE_URL is empty.
VITE_DEV_API_PROXY=http://localhost:8080

# Firebase web app config (public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase Auth emulator, e.g. http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Development only: in-memory mock API and fake sign-in. Ignored in production builds.
VITE_USE_MOCK_API=false
