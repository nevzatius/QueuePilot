# Local demo resources only. Never place real credentials in this file.
QP_ENV=development
GCLOUD_PROJECT=demo-queuepilot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
REDIS_URL=redis://127.0.0.1:6379
QP_REDIS_ENABLED=true
QP_MAX_INSTANCES=5
QP_QUOTA_FAILURE_MODE=closed

# QStash profile (free tier, ADR-019). Keep real values out of this file; use Render secret env vars.
# QP_QUEUE_ADAPTER=qstash
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QP_QSTASH_RETRIES=2
# QP_QSTASH_TIMEOUT=90s
