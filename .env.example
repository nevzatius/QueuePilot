# Local demo resources only. Never place real credentials in this file.
QP_ENV=development
GCLOUD_PROJECT=demo-queuepilot
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
REDIS_URL=redis://127.0.0.1:6379
QP_REDIS_ENABLED=true
QP_MAX_INSTANCES=5
QP_QUOTA_FAILURE_MODE=closed

# QStash profile (free tier, ADR-019). Keep real values out of this file; use Render secret env vars.
# QP_QUEUE_ADAPTER=qstash
# Worker auth follows the backend: qstash adapter -> QP_WORKER_AUTH_MODE=qstash (the default under qstash; oidc is rejected).
# QP_WORKER_URL must be the PUBLIC https origin QStash calls (no path, no trailing slash): the expected JWT `sub` is built from it.
# QP_WORKER_URL=https://your-worker.onrender.com
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QP_QSTASH_RETRIES=2
# QP_QSTASH_TIMEOUT=90s
# Optional. QStash tokens are regional: set the origin shown next to your token.
# QSTASH_URL=https://qstash.upstash.io

# Browser access (API only; the worker never sends CORS headers).
# Comma separated exact https origins allowed to call the API from a browser: no wildcard, path, trailing slash or userinfo.
# http://localhost and http://127.0.0.1 (any port) are accepted outside production only. Empty means no cross-origin access.
# QP_CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com

# Client IP behind a platform proxy: number of trusted proxy hops, the socket counting as hop 0 (integer 0 to 5).
# 0 (the default) ignores X-Forwarded-For. Render needs 3 (ADR-019 spike, n=1); re-verify live in B9-9 and whenever the platform changes.
# TRUST_PROXY_HOPS=3

# Redis connect timeout in milliseconds (100 to 3000, default 1500). Cold connect to Upstash free measured about 400 ms.
# QP_REDIS_CONNECT_TIMEOUT_MS=1500

# Service-account key as one secret, for hosts without an ambient Google identity (Render). The whole JSON file content, set only as a
# Render secret or in your shell session, never in a file in the repo. Rejected next to an emulator or a demo-* project; leave it unset on Cloud Run.
# QP_FIREBASE_SERVICE_ACCOUNT_JSON=
